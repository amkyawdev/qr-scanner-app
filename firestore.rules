rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to read any document
    match /{document=**} {
      allow read: if true;
    }
    
    // Allow anyone to create users
    match /users/{userId} {
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }
  }
}